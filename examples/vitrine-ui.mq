<project name="Vitrine UI" modes="light dark" library desc="Bibliothèque partagée : un projet l'utilise avec &lt;use lib=&quot;Vitrine UI&quot;/&gt; et ses composants restent liés">
  <system brand=#6D5AE6 accent=#F97316 neutral=cool radius=round density=comfortable elevation=soft motion=playful type="Inter/Inter Tight"/>
  <!-- gerbe : jaillit (dépassement), puis s'évanouit en s'éloignant. Au repos elle est invisible (opacity=0 sur le calque) -->
  <keyframes name="spark">
    0 { scale=0.2 opacity=1 }
    55 { scale=1.15 opacity=1 }
    100 { scale=1.35 opacity=0 }
  </keyframes>
  <!-- ♥ bouton J'aime : le cœur s'écrase à l'appui, un éclat radial jaillit à l'activation -->
  <component name=LikeButton props="liked=false count=128" desc="Bouton J'aime avec éclat (état local)" group=Contrôles>
    <row h=$button-h-md px=16 gap=8 radius=$chip-radius fill={liked ? $danger-soft : $surface-2} color={liked ? $danger-text : $text} motion=press cursor=pointer on:click="change liked={!liked} smart 320 bouncy" aria-label="J'aime">
      <stack w=24 h=24 center>
        <!-- couronne centrée sur le cœur : point de 6 en (9, -8), pivot à 17px sous son centre = centre de la boîte 24 (12, 12) -->
        <ellipse if={liked} name=burst absolute x=9 y=-8 w=6 h=6 opacity=0 fill=$accent clone="radial 8 r=17" anim="spark 640 out"/>
        <icon name=ph-fill:heart size=22 color={liked ? $danger : $muted} anim={liked ? 'squish 420' : ''}/>
      </stack>
      <text weight=600 tabular>{count + (liked ? 1 : 0)}</text>
    </row>
  </component>
  <!-- interrupteur à ressort : le curseur traverse avec un léger dépassement (bouncy) -->
  <component name=Switch props="on=false label='Mode sombre'" desc="Interrupteur (état local, ressort)" group=Contrôles>
    <!-- libellé w=fill : il passe à la ligne au lieu de pousser le rail hors de la carte ; 16 entre texte et rail -->
    <row w=fill gap=16 cursor=pointer on:click="change on={!on} smart 380 bouncy" aria-label={label}>
      <text w=fill weight=500 lh=1.4>{label}</text>
      <!-- rail 52×32, curseur 24 : inset 4 partout (absolu → x=4 / 52−4−24 = 24, y=(32−24)/2 = 4) -->
      <stack w=52 h=32 radius=full fill={on ? $primary : $surface-3}>
        <ellipse name=thumb w=24 h=24 x={on ? 24 : 4} y=4 fill=$surface shadow=$shadow-2/>
      </stack>
    </row>
  </component>
  <!-- contrôle segmenté : un seul indicateur qui glisse d'une option à l'autre (smart animate par nom).
       Anatomie : rail 48 (padding 4 constant sur les 4 côtés) → piste interne 40 → indicateur = exactement une case.
       L'indicateur vit dans la piste interne : ses % se calculent sur la piste, pas sur le rail + son padding. -->
  <component name=SegmentPill props="value=0 items={['Jour', 'Semaine', 'Mois']}" desc="Segmenté à indicateur glissant" group=Contrôles>
    <stack w=fill h=48 radius=$chip-radius fill=$surface-2 p=4>
      <stack w=fill h=40>
        <frame name=seg-indicator x={value * 100 / len(items) + '%'} y=0 w={100 / len(items) + '%'} h=40 radius=$chip-radius fill=$surface shadow=$shadow-1/>
        <row w=fill h=40>
          <stack each={items} as=lbl w=fill h=40 px=12 center cursor=pointer on:click="change value={i} smart 340 gentle" aria-label={lbl}>
            <text size=14 weight={i == value ? 600 : 500} color={i == value ? $text : $muted} nowrap>{lbl}</text>
          </stack>
        </row>
      </stack>
    </stack>
  </component>
  <!-- note en étoiles riggée : glisser horizontalement, pas de 1 -->
  <component name=Stars props="value=4" desc="Note 0..5 (rig x, pas de 1)" rig:value="x 0..5 step=1 in=stars" group=Contrôles>
    <row name=stars gap=4 cursor=pointer>
      <icon each={range(5)} name={i < value ? 'ph-fill:star' : 'ph:star'} size=28 color={i < value ? $accent : $subtle}/>
    </row>
  </component>
  <!-- bouton rotatif riggé : glisser en cercle ; l'anneau d'arc suit la valeur -->
  <component name=Dial props="value=0.62 label='Volume'" desc="Bouton rotatif riggé (angle) avec anneau" rig:value="angle 0..1 from=-135 to=135 in=dial-face" group=Contrôles>
    <col gap=8 align=center>
      <!-- face 144 : anneau de 12 (ratio 120/144), écart 8, bouton 104 — tout sur la grille de 4 -->
      <stack name=dial-face w=144 h=144 center>
        <shape kind=ring ratio=0.8333 start=135 sweep=270 w=144 h=144 fill=$surface-3/>
        <shape if={value > 0} kind=ring ratio=0.8333 start=135 sweep={value * 270} w=144 h=144 fill=$primary/>
        <stack w=104 h=104 radius=full fill=$surface shadow=$shadow-2 center rotate={-135 + value * 270}>
          <frame w=4 h=16 radius=full fill=$primary absolute top=8 x=center/>
        </stack>
      </stack>
      <text size=14 color=$muted>{label} · {round(value * 100)} %</text>
    </col>
  </component>
  <!-- téléchargement : repos → chargement (barre qui se remplit) → terminé (coche qui rebondit) -->
  <component name=DownloadButton props="phase=0" desc="Bouton en trois phases (0 repos, 1 chargement, 2 terminé)" group=Actions>
    <stack w=fill h=$button-h-md radius=$button-radius clip fill={phase == 2 ? $success : $primary} color={phase == 2 ? $on-success : $on-primary} motion=press cursor=pointer on:click="if {phase == 0} change phase=1 smart 260 snappy; wait 1300; if {phase == 1} change phase=2 smart 360 bouncy">
      <frame if={phase == 1} name=dl-bar w=fill h=fill fill={alpha($on-primary, 20)} anim="reveal 1300 linear"/>
      <row w=fill h=fill gap=8 justify=center>
        <icon if={phase == 0} name=download size=18/>
        <icon if={phase == 1} name=loader-circle size=18 loop="spin 900"/>
        <icon if={phase == 2} name=check size=18 anim="pop 420 hard"/>
        <text weight=600>{phase == 0 ? 'Télécharger' : phase == 1 ? 'Téléchargement…' : 'Terminé'}</text>
      </row>
    </stack>
  </component>
  <!-- compteur : moins / plus avec bornes, l'affichage rebondit à chaque pas -->
  <component name=Stepper props="count=2 min=0 max=9 label='Invités'" desc="Compteur borné (inc / dec locaux)" group=Actions>
    <row w=fill justify=between>
      <col gap=2><text weight=500>{label}</text><text size=14 color=$muted>{count == max ? 'Maximum atteint' : 'De ' + min + ' à ' + max}</text></col>
      <row gap=12>
        <stack w=44 h=44 radius=full center fill=$surface-2 motion=press cursor=pointer opacity={count == min ? 0.4 : 1} on:click="if {count > min} dec count" aria-label="Moins"><icon name=minus size=18/></stack>
        <text w=24 size=$text-xl weight=700 talign=center tabular key={'n' + count} anim="pop 260 hard">{count}</text>
        <stack name=plus w=44 h=44 radius=full center fill=$primary color=$on-primary motion=press cursor=pointer opacity={count == max ? 0.4 : 1} on:click="if {count < max} inc count" aria-label="Plus"><icon name=plus size=18/></stack>
      </row>
    </row>
  </component>
  <!-- notification : apparition en rebond, contenu en cascade, fermeture -->
  <component name=Notice props="open=true title='Nouveau message' text='Léa a commenté ta maquette.'" desc="Notification (apparition pop, contenu en cascade)" group=Actions>
    <row if={open} w=fill gap=12 p=16 radius=$card-radius fill=$surface shadow=$shadow-3 align=start motion="pop">
      <image src={'avatar:' + fake('name', 4)} w=40 h=40 radius=full/>
      <col w=fill gap=4 motion=cascade><text weight=600>{title}</text><text size=14 color=$muted lh=1.45>{text}</text></col>
      <!-- cible 44, glyphe 16 : le glyphe s'aligne sur le padding (16 du bord droit) et sur la ligne du titre -->
      <stack name=close w=44 h=44 mt=-10 mr=-14 mb=-10 radius=full center cursor=pointer motion=press on:click="change open=false smart 260 snappy" aria-label="Fermer"><icon name=x size=16 color=$muted/></stack>
    </row>
  </component>
  <screen name="Catalogue" device=desktop h=auto fill=$bg color=$text font=$font-sans>
    <col w=fill maxw=1120 mx=auto px=48 py=56 gap=32>
      <col gap=8><text size=12 weight=600 color=$primary-text upper ls=8%>Bibliothèque</text><text size=$text-3xl weight=700>Vitrine UI · états limites</text><text color=$muted maxw=640 lh=1.5>Chaque composant dans ses états extrêmes : la page de contrôle de la bibliothèque. Les projets qui la lient (&lt;use lib="Vitrine UI"/&gt;) reçoivent ses mises à jour.</text></col>
      <grid cols=3 gap=24 w=fill>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface><SegmentPill value=0/><SegmentPill value=2/><SegmentPill value=1 items={['A', 'B', 'C', 'D']}/></col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface><DownloadButton phase=1/><DownloadButton phase=2/><LikeButton liked count=9999/></col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface><Stepper count=9/><Stepper count=0/><Switch on label="Un libellé assez long pour tester le retour à la ligne"/></col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface><Dial value=0/><Dial value=1/></col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface><Stars value=0/><Stars value=5/></col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface><Notice title="Un titre plus long qui passe sur deux lignes sans casser la croix"/></col>
      </grid>
    </col>
  </screen>
</project>

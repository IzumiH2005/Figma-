<project name="Corde — un champ de saisie vivant" modes="light dark" typescale=material>
  <!-- Corde : un champ texte pensé comme une corde tendue. Tout passe par le moteur de motion :
       · au focus, la ligne de base se GONFLE en membrane (pathmix sur trois clés : repos → gonfle → actif) ;
         le ressort « bouncy » dépasse la cible et la forme déborde un instant : pathmix extrapole au-delà de 0..1 ;
       · l'étiquette SAUTE le long d'un trajet (along=vol) : petite anticipation vers le bas, puis arc vers le haut ;
       · chaque frappe PINCE la corde (change pl=1 puis pl=0 en ressort « wobbly ») : elle vibre et s'amortit ;
       · une adresse invalide TORD le bas en zigzag rouge et secoue le champ (play corde shake) ;
       · une adresse valide gonfle le bouton d'envoi (couleur et flèche suivent v, interpolées en OKLab) ;
       · à l'envoi, la membrane SE NOUE autour du bouton (clé noeud), la coche se dessine trait par trait, éclats.
       Toutes les propriétés d'instance voyagent image par image : « change k=v tween ms ressort & » (& = en parallèle).
       Les clés de forme sont les vecteurs posés à droite : redessine-les à la souris, le champ suit. -->
  <system brand=#5B3FD9 accent=#E0567A neutral=cool radius=round density=comfortable elevation=soft motion=playful type="Roboto/Roboto"/>

  <vars>
    email: ''
    s_repos: ''
    s_focus: ''
    s_frappe: 'ada'
    s_err: 'ada@gmail'
    s_ok: 'ada@gmail.com'
  </vars>

  <keyframes name="spark">
    0 { opacity=1 scale=1 y=0 }
    55 { opacity=1 scale=0.9 y=-30 }
    100 { opacity=0 scale=0.3 y=-44 }
  </keyframes>

  <component name=Corde props="label='Adresse e-mail' placeholder='nom@domaine.fr' hint='Valable 15 minutes, sans mot de passe.' error='Adresse incomplète : ajoute un domaine, par exemple @gmail.com' bind='email' f=0 foc=0 err=0 pl=0 v=0 sent=0"
             desc="Champ-corde : la ligne se gonfle au focus, vibre à chaque frappe, se tord sur erreur et se noue autour du bouton à l'envoi. f, foc, err, pl, v, sent : 0..1 (états animés)">
    <col w=380 gap=8>
      <stack name=corde w=380 h=84>
        <!-- trajet du saut de l'étiquette (invisible) -->
        <vector name=vol absolute x=0 y=0 w=48 h=64 fill=none stroke=none d="M24 52C24 60 44 14 24 10"/>
        <!-- la corde / membrane : quatre ressorts empilés, plus le nœud -->
        <vector name=membrane absolute x=0 y=24 w=380 h=56 cap=round join=round
                fill={alpha(keys(err, $primary, $danger), 0.04 + foc * 0.06)}
                stroke={(1.5 + foc * 0.5) + ' ' + keys(sent, keys(err, keys(foc, $muted, $primary), $danger), $success)}
                d={pathmix(sent, pathmix(pl, pathmix(err, pathmix(f, repos, gonfle, actif), erreur), pincee), noeud)}/>
        <stack name=etiquette along=vol at={f} w=2 h=2 scale={keys(f, 1, 0.8)} opacity={1 - sent}>
          <text absolute x=0 y=-12 nowrap class=t-body-lg weight=500 color={keys(err, keys(foc, $text-2, $primary), $danger)}>{label}</text>
        </stack>
        <input name=saisie absolute x=24 y=24 w=296 h=56 bind={bind} type=text class=t-body-lg color=$text opacity={1 - sent}
               placeholder={foc > 0.5 ? placeholder : ''} aria-label={label}
               on:focus="change foc=1 tween 180 out &; change f=1 tween 760 bouncy &"
               on:blur="change foc=0 tween 220 out &; change f={len(value) > 0 ? 1 : 0} tween 520 snap &"
               on:input="change err=0 tween 200 out &; change v={includes(value, '@') && includes(last(split(value, '@')), '.') && len(last(split(value, '.'))) >= 2 && len(first(split(value, '@'))) >= 1 ? 1 : 0} tween 640 bouncy &; change pl=1 tween 70 out; change pl=0 tween 900 wobbly &"
               on:submit="change err={includes(dollar(bind), '@') && includes(last(split(dollar(bind), '@')), '.') && len(last(split(dollar(bind), '.'))) >= 2 && len(first(split(dollar(bind), '@'))) >= 1 ? 0 : 1} tween 260 snap &; change sent={includes(dollar(bind), '@') && includes(last(split(dollar(bind), '@')), '.') && len(last(split(dollar(bind), '.'))) >= 2 && len(first(split(dollar(bind), '@'))) >= 1 ? 1 : 0} tween 1100 snappy &; if {!(includes(dollar(bind), '@') && includes(last(split(dollar(bind), '@')), '.') && len(last(split(dollar(bind), '.'))) >= 2 && len(first(split(dollar(bind), '@'))) >= 1)} play corde shake"/>
        <!-- bouton d'envoi : 48 dp, inset 4, rayon imbriqué 28 − 4 = 24 -->
        <stack name=envoyer absolute x=328 y=28 w=48 h=48 radius=full center aria-label="Envoyer le lien"
               scale={clamp((f - 0.5) * 2, 0, 1.3)}
               fill={keys(sent, keys(v, $surface-2, $primary), $success)}
               color={v > 0.5 ? $on-primary : $text-2}
               on:click="change err={includes(dollar(bind), '@') && includes(last(split(dollar(bind), '@')), '.') && len(last(split(dollar(bind), '.'))) >= 2 && len(first(split(dollar(bind), '@'))) >= 1 ? 0 : 1} tween 260 snap &; change sent={includes(dollar(bind), '@') && includes(last(split(dollar(bind), '@')), '.') && len(last(split(dollar(bind), '.'))) >= 2 && len(first(split(dollar(bind), '@'))) >= 1 ? 1 : 0} tween 1100 snappy &; if {!(includes(dollar(bind), '@') && includes(last(split(dollar(bind), '@')), '.') && len(last(split(dollar(bind), '.'))) >= 2 && len(first(split(dollar(bind), '@'))) >= 1)} play corde shake">
          <icon name=arrow-right size=20 rotate={keys(v, -90, 0)} opacity={1 - sent}/>
          <vector absolute x=12 y=12 w=24 h=24 fill=none stroke={'3 ' + $on-success} cap=round join=round
                  d={pathmix(clamp(sent * 1.8 - 0.8, 0, 1), coche0, coche1, coche2)}/>
        </stack>
        <!-- éclats à l'envoi -->
        <frame repeat=8 if={sent > 0.85} absolute x=348 y=48 w=8 h=8 rotate={i * 45}>
          <frame w=8 h=8 radius=full opacity=0 fill={i % 2 ? $primary : $accent-400} anim="spark 720 hold"/>
        </frame>
        <text if={sent > 0.6} absolute x=24 y=40 w=280 nowrap class=t-title-sm color=$text anim="fade-up 360">Lien envoyé, regarde ta boîte</text>
      </stack>

      <col w=fill px=24 gap=8 minh=24>
        <row if={err > 0.5} w=fill gap=4 color=$danger anim="fade-up 240">
          <icon name=circle-alert size=16/>
          <text w=fill class=t-body-sm>{error}</text>
        </row>
        <text if={err <= 0.5 && sent < 0.5} w=fill class=t-body-sm color=$text-2>{hint}</text>
      </col>

      <!-- domaines suggérés : apparaissent en cascade dès qu'on tape « @ » -->
      <row if={includes(dollar(bind), '@') && !includes(last(split(dollar(bind), '@')), '.') && sent < 0.5} w=fill px=8 gap=8 stagger="50 pop 380 drag=1.1">
        <stack each={['gmail.com', 'outlook.fr', 'proton.me']} as=dom if={includes(dom, last(split(dollar(bind), '@')))} minw=48 h=48 center
               on:click="set ${bind} = {first(split(dollar(bind), '@')) + '@' + dom}; change err=0 tween 200 out &; change f=1 tween 520 snap &; change v=1 tween 640 bouncy">
          <Chip label={dom}/>
        </stack>
      </row>
    </col>
  </component>

  <page name="Corde">
    <screen name="Connexion" device=pixel-9 start statusbar homebar fill=$bg>
      <col w=fill px=16 pt=safe+24 pb=120 gap=24 stagger="70 fade-up 480 drag=1.1">
        <stack w=fill h=176 radius=$card-radius fill=$brand-700 center
               shader="mesh warp=0.35 speed=0.2 colors=#2A1A7A,#5B3FD9,#E0567A,#1B1450 pointer=glow reach=140">
          <stack w=88 h=88 radius=full fill={alpha('#FFFFFF', 0.16)} color=$on-primary center loop="float 3200">
            <icon name=mail size=40/>
          </stack>
        </stack>
        <col w=fill gap=8>
          <text class=t-h1>Connecte-toi sans mot de passe</text>
          <text class=t-body color=$text-2>Saisis ton adresse : on t’envoie un lien magique pour entrer.</text>
        </col>
        <Corde/>
      </col>
      <row fixed place=bottom w=fill px=16 pt=12 pb=safe+16 fill=$bg>
        <Button label="Utiliser un mot de passe" kind=ghost w=fill/>
      </row>
    </screen>

    <!-- planche des états : instances figées, chaque état est une simple valeur de prop -->
    <note x=520 y=-56 w=412>États de Corde. Chaque état n'est qu'un nombre entre 0 et 1 : le prototype les fait voyager avec des ressorts.</note>
    <col x=520 y=40 w=412 p=16 gap=8 radius=$card-radius fill=$bg>
      <text class=t-label color=$text-2>Repos</text>
      <Corde f=0 bind=s_repos/>
    </col>
    <col x=520 y=248 w=412 p=16 gap=8 radius=$card-radius fill=$bg>
      <text class=t-label color=$text-2>Focus : la ligne se gonfle</text>
      <Corde f=1 foc=1 bind=s_focus/>
    </col>
    <col x=520 y=456 w=412 p=16 gap=8 radius=$card-radius fill=$bg>
      <text class=t-label color=$text-2>Frappe : la corde vibre</text>
      <Corde f=1 foc=1 pl=0.8 bind=s_frappe/>
    </col>
    <col x=520 y=664 w=412 p=16 gap=8 radius=$card-radius fill=$bg>
      <text class=t-label color=$text-2>Erreur : zigzag + secousse</text>
      <Corde f=1 foc=1 err=1 bind=s_err/>
    </col>
    <col x=520 y=872 w=412 p=16 gap=8 radius=$card-radius fill=$bg>
      <text class=t-label color=$text-2>Valide : le bouton s’allume</text>
      <Corde f=1 foc=1 v=1 bind=s_ok/>
    </col>
    <col x=520 y=1080 w=412 p=16 gap=8 radius=$card-radius fill=$bg>
      <text class=t-label color=$text-2>Envoyé : la corde se noue</text>
      <Corde f=1 v=1 sent=1 bind=s_ok/>
    </col>

    <!-- clés de forme : même structure (18 nœuds), donc interpolation exacte nœud par nœud -->
    <note x=980 y=-40 w=380>Clés de la corde (380 × 56). Double-clic sur un tracé, tire les points ou courbe le segment : le champ suit en direct.</note>
    <vector name=repos x=980 y=40 w=380 h=56 fill=none stroke="2 $primary" cap=round join=round
            d="M28 55C50.3 55 72.7 55 95 55C126.7 55 158.3 55 190 55C221.7 55 253.3 55 285 55C307.3 55 329.7 55 352 55C362.5 55 368.5 55 379 55C379 55 379 55 379 55C368.5 55 362.5 55 352 55C345.5 55 339 55 332.5 55C316.7 55 300.8 55 285 55C269.2 55 253.3 55 237.5 55C221.7 55 205.8 55 190 55C174.2 55 158.3 55 142.5 55C126.7 55 110.8 55 95 55C79.2 55 63.3 55 47.5 55C41 55 34.5 55 28 55C17.5 55 11.5 55 1 55C1 55 1 55 1 55C11.5 55 17.5 55 28 55Z"/>
    <vector name=gonfle x=980 y=136 w=380 h=56 fill=none stroke="2 $primary" cap=round join=round
            d="M34 24C53.7 17.5 74.4 13.6 95 11C126.5 7 158.2 4 190 4C221.8 4 253.5 7 285 11C305.6 13.6 326.3 17.5 346 24C357.6 27.8 369 28.4 373 40C374.2 43.4 379 45.4 379 49C379 59.8 362.8 55 352 55C345.5 55 339 55 332.5 55C316.7 55 300.8 55 285 55C269.2 55 253.3 55 237.5 55C221.7 55 205.8 55 190 55C174.2 55 158.3 55 142.5 55C126.7 55 110.8 55 95 55C79.2 55 63.3 55 47.5 55C41 55 34.5 55 28 55C17.2 55 1 59.8 1 49C1 45.4 5.8 43.4 7 40C11 28.4 22.4 27.8 34 24Z"/>
    <vector name=actif x=980 y=232 w=380 h=56 fill=none stroke="2 $primary" cap=round join=round
            d="M28 1C50.3 1 72.7 1 95 1C126.7 1 158.3 1 190 1C221.7 1 253.3 1 285 1C307.3 1 329.7 1 352 1C366.9 1 379 13.1 379 28C379 28 379 28 379 28C379 42.9 366.9 55 352 55C345.5 55 339 55 332.5 55C316.7 55 300.8 55 285 55C269.2 55 253.3 55 237.5 55C221.7 55 205.8 55 190 55C174.2 55 158.3 55 142.5 55C126.7 55 110.8 55 95 55C79.2 55 63.3 55 47.5 55C41 55 34.5 55 28 55C13.1 55 1 42.9 1 28C1 28 1 28 1 28C1 13.1 13.1 1 28 1Z"/>
    <vector name=pincee x=980 y=328 w=380 h=64 fill=none stroke="2 $primary" cap=round join=round
            d="M28 1C50.3 1 72.7 1 95 1C126.7 1 158.3 1 190 1C221.7 1 253.3 1 285 1C307.3 1 329.7 1 352 1C366.9 1 379 13.1 379 28C379 28 379 28 379 28C379 42.9 366.9 55 352 55C345.4 55 339 57.2 332.5 57.7C316.7 58.8 300.8 59.3 285 59.9C269.2 60.6 253.3 61.1 237.5 61.5C221.7 61.8 205.8 62 190 62C174.2 62 158.3 61.8 142.5 61.5C126.7 61.1 110.8 60.6 95 59.9C79.2 59.3 63.3 58.8 47.5 57.7C41 57.2 34.6 55 28 55C13.1 55 1 42.9 1 28C1 28 1 28 1 28C1 13.1 13.1 1 28 1Z"/>
    <vector name=erreur x=980 y=432 w=380 h=64 fill=none stroke="2 $primary" cap=round join=round
            d="M28 1C50.3 1 72.7 1 95 1C126.7 1 158.3 1 190 1C221.7 1 253.3 1 285 1C307.3 1 329.7 1 352 1C366.9 1 379 13.1 379 28C379 28 379 28 379 28C379 42.9 366.9 55 352 55C345.4 55 332.5 59 332.5 59C332.5 59 285 51 285 51C285 51 237.5 59 237.5 59C237.5 59 190 51 190 51C190 51 142.5 59 142.5 59C142.5 59 95 51 95 51C95 51 47.5 59 47.5 59C47.5 59 34.6 55 28 55C13.1 55 1 42.9 1 28C1 28 1 28 1 28C1 13.1 13.1 1 28 1Z"/>
    <vector name=noeud x=980 y=536 w=380 h=56 fill=none stroke="2 $primary" cap=round join=round
            d="M325 28C325 24.9 325.6 21.7 326.6 18.8C327.7 15.8 329.3 13 331.3 10.6C333.3 8.3 335.8 6.2 338.5 4.6C341.2 3.1 344.2 2 347.3 1.4C350.4 0.9 353.6 0.9 356.7 1.4C359.8 2 362.8 3.1 365.5 4.6C368.2 6.2 370.7 8.3 372.7 10.6C374.7 13 376.3 15.8 377.4 18.8C378.4 21.7 379 24.9 379 28C379 31.1 378.4 34.3 377.4 37.2C376.3 40.2 374.7 43 372.7 45.4C370.7 47.7 368.2 49.8 365.5 51.4C362.8 52.9 359.8 54 356.7 54.6C353.6 55.1 350.4 55.1 347.3 54.6C344.2 54 341.2 52.9 338.5 51.4C335.8 49.8 333.3 47.7 331.3 45.4C329.3 43 327.7 40.2 326.6 37.2C325.6 34.3 325 31.1 325 28Z"/>
    <note x=980 y=632 w=380>Coche, dessinée en deux traits (24 × 24).</note>
    <vector name=coche0 x=980 y=704 w=24 h=24 fill=none stroke="2 $primary" cap=round join=round
            d="M5 12.5C5 12.5 5 12.5 5 12.5C5 12.5 5 12.5 5 12.5"/>
    <vector name=coche1 x=1024 y=704 w=24 h=24 fill=none stroke="2 $primary" cap=round join=round
            d="M5 12.5C5 12.5 10 17.5 10 17.5C10 17.5 10 17.5 10 17.5"/>
    <vector name=coche2 x=1068 y=704 w=24 h=24 fill=none stroke="2 $primary" cap=round join=round
            d="M5 12.5C5 12.5 10 17.5 10 17.5C10 17.5 19 7 19 7"/>
  </page>

  <flow name=demo>
    start Connexion
    wait 1600
    click "saisie"
    wait 1000
    type "saisie" "ada@"
    wait 1000
    key Enter
    wait 1400
    type "saisie" "gm"
    wait 900
    click "gmail.com"
    wait 1100
    click "envoyer"
    wait 2400
  </flow>
</project>

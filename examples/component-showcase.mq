<project name="Vitrine de composants" modes="light dark">
  <!-- Les composants (et le design system) viennent de la bibliothèque 📚 Vitrine UI (examples/vitrine-ui.mq) :
       modifie-la, et cette vitrine suit. mq lib list examples/vitrine-ui.mq pour son contenu. -->
  <use lib="Vitrine UI"/>

  <screen name="Vitrine" device=desktop h=auto fill=$bg color=$text font=$font-sans>
    <col w=fill maxw=1120 mx=auto px=48 py=56 gap=40>
      <col gap=8 motion=appear>
        <text size=12 weight=600 color=$primary-text upper ls=8%>Composants de test</text>
        <text size=$text-4xl weight=700 lh=1.05>Propres, liés au système, vivants</text>
        <text size=$text-lg color=$muted maxw=640 lh=1.5>Clique, glisse, tourne : chaque composant garde son état et anime ses changements avec le moteur de motion.</text>
      </col>
      <grid cols=3 gap=24 w=fill align=stretch motion=cascade>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface shadow=$shadow-1>
          <text size=12 weight=600 color=$muted upper ls=6%>J'aime · éclat</text>
          <row gap=12><LikeButton/><LikeButton liked count=42/></row>
        </col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface shadow=$shadow-1>
          <text size=12 weight=600 color=$muted upper ls=6%>Interrupteurs · ressort</text>
          <Switch/><Switch on label="Notifications"/>
        </col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface shadow=$shadow-1>
          <text size=12 weight=600 color=$muted upper ls=6%>Segmenté · indicateur</text>
          <SegmentPill value=1/>
        </col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface shadow=$shadow-1>
          <text size=12 weight=600 color=$muted upper ls=6%>Téléchargement · 3 phases</text>
          <DownloadButton/>
        </col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface shadow=$shadow-1>
          <text size=12 weight=600 color=$muted upper ls=6%>Compteur · bornes</text>
          <Stepper/>
        </col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface shadow=$shadow-1 align=center>
          <text size=12 weight=600 color=$muted upper ls=6% self=start>Bouton rotatif · rig</text>
          <Dial/>
        </col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface-2 span=2>
          <text size=12 weight=600 color=$muted upper ls=6%>Notification · pop + cascade</text>
          <Notice/>
        </col>
        <col gap=16 p=$card-pad radius=$card-radius fill=$surface shadow=$shadow-1>
          <text size=12 weight=600 color=$muted upper ls=6%>Note · rig x</text>
          <Stars/>
        </col>
      </grid>
    </col>
  </screen>

  <flow name="demo">
    start Vitrine
    wait 1400
    click "128"
    wait 700
    click "Mode sombre"
    wait 700
    click "Mois"
    wait 700
    click "Télécharger"
    wait 2200
    click plus
    wait 500
    click plus
    wait 700
    click close
    wait 900
  </flow>
</project>
